NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gsc:gsc_dev_password@localhost:5433/gsc_optimizer
FRONTEND_ORIGIN=http://localhost:3100
# 64+ random chars each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6380
# Google OAuth client (Web application) with the Search Console API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gsc/oauth/callback
# Days to fetch on the first sync (max 480 = GSC retention)
GSC_INITIAL_SYNC_DAYS=90
# Crawler (all optional; defaults shown)
CRAWLER_USER_AGENT=BlogPilotBot/1.0
CRAWLER_MAX_PAGES=500
CRAWLER_CONCURRENCY=2
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_DELAY_MS=500
CRAWLER_MAX_DURATION_MS=1800000
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_MIN_CONTENT_WORDS=80
CRAWLER_PLAYWRIGHT_ENABLED=true
CRAWLER_PLAYWRIGHT_MAX_PAGES=25
CRAWLER_PLAYWRIGHT_TIMEOUT_MS=20000
