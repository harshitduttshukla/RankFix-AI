NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gsc:gsc_dev_password@localhost:5433/gsc_optimizer
FRONTEND_ORIGIN=http://localhost:3100
# 64+ random chars each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6380
# Google OAuth client (Web application) with the Search Console API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gsc/oauth/callback
# Days to fetch on the first sync (max 480 = GSC retention)
GSC_INITIAL_SYNC_DAYS=90
# Crawler (all optional; defaults shown)
CRAWLER_USER_AGENT=BlogPilotBot/1.0
CRAWLER_MAX_PAGES=500
CRAWLER_CONCURRENCY=2
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_DELAY_MS=500
CRAWLER_MAX_DURATION_MS=1800000
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_MIN_CONTENT_WORDS=80
CRAWLER_PLAYWRIGHT_ENABLED=true
CRAWLER_PLAYWRIGHT_MAX_PAGES=25
CRAWLER_PLAYWRIGHT_TIMEOUT_MS=20000
# Opportunity engine thresholds (all optional; defaults shown)
OPPORTUNITY_WINDOW_DAYS=28
OPPORTUNITY_MIN_IMPRESSIONS=200
OPPORTUNITY_LOW_CTR_RATIO=0.6
OPPORTUNITY_LOW_CTR_MAX_POSITION=20
OPPORTUNITY_LOW_CTR_MIN_IMPRESSIONS=500
OPPORTUNITY_PAGE_ONE_MIN_POSITION=4
OPPORTUNITY_PAGE_ONE_MAX_POSITION=10
OPPORTUNITY_PAGE_ONE_MIN_IMPRESSIONS=300
OPPORTUNITY_HIGH_IMPRESSIONS=5000
OPPORTUNITY_HIGH_IMPRESSIONS_MAX_CTR=0.015
OPPORTUNITY_MIN_DECLINE_PERCENT=25
OPPORTUNITY_MIN_QUERY_IMPRESSIONS=100
# AI analysis (Phase 5). Required to run analyses; the app starts without them.
# AI_PROVIDER selects the implementation: gemini | openrouter. Only the selected provider's key is needed.
AI_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey). Used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Used when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ID for the selected provider. Gemini: a model available to your key (e.g. from ListModels);
# OpenRouter: vendor/model with structured-output support.
AI_MODEL=
AI_MAX_TOKENS=16000
AI_TIMEOUT_MS=180000
# OpenRouter only (Gemini relies on the job queue's retries): transient-error retries per job attempt
AI_MAX_RETRIES=1
# OpenRouter only: json_schema (recommended; model must support structured outputs) | prompt (schema sent in the system message; for models without it)
AI_OUTPUT_MODE=json_schema
# OpenRouter only, optional: none | minimal | low | medium | high | xhigh | max (unified reasoning). Leave empty to omit.
AI_REASONING_EFFORT=

# AI drafts (optional): max characters per drafted field, and how many new drafts a reviewer may request per recommendation
# AI_DRAFT_MAX_TITLE=70
# AI_DRAFT_MAX_META_DESCRIPTION=160
# AI_DRAFT_MAX_H1=90
# AI_DRAFT_MAX_SECTION_HEADING=90
# AI_DRAFT_MAX_INTRODUCTION=1200
# AI_DRAFT_MAX_REGENERATIONS=5

# Content originality check (internal corpus only: this project's crawled pages; nothing is sent to external services)
# ORIGINALITY_CHECKER=internal            # internal | none
# ORIGINALITY_POLICY=require_ack          # off | warn | require_ack | block
# ORIGINALITY_REQUIRE_CHECK=true          # a failed check blocks approval of checkable text
# ORIGINALITY_MIN_MATCH_WORDS=6
# ORIGINALITY_SIGNIFICANT_RUN_WORDS=12
# ORIGINALITY_SIGNIFICANT_COVERAGE=0.5
# ORIGINALITY_COMMON_PHRASE_MIN_PAGES=3
# ORIGINALITY_COMMON_PHRASE_RATIO=0.3
# ORIGINALITY_MAX_CORPUS_PAGES=2000
# ORIGINALITY_RESULT_TTL_MINUTES=60

# Body-section rewrites (only on reviewer request; strict fact preservation)
# AI_BODY_MIN_WORDS=15
# AI_BODY_MAX_WORDS=800
# AI_BODY_MAX_PARAGRAPHS=8
# AI_BODY_MIN_LENGTH_RATIO=0.6       # draft words ≥ 60% of the original
# AI_BODY_MAX_LENGTH_RATIO=1.5       # draft words ≤ 150% of the original, or original + slack if larger
# AI_BODY_LENGTH_SLACK_WORDS=25      # lets short sections grow by up to this many words
# AI_BODY_MAX_CHANGE_RATIO=0.85      # word-level edit distance / longer text
# AI_BODY_MIN_TERM_OVERLAP=0.4       # share of the original's content words kept
# AI_BODY_MIN_FACT_PRESERVATION=1    # share of the original's numbers and names kept
